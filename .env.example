# Copier en .env et compléter. Générer SECRET_KEY avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=on
SECRET_KEY=

# Base de données MySQL
DB_USER=
DB_PASSWORD=
DB_DATABASE=recette
DB_HOST=localhost
DB_PORT=3306

# Emails (en DEBUG, tous les emails partent vers DEBUG_EMAIL)
DEBUG_EMAIL=
DEFAULT_FROM_EMAIL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=465

APP_NAME=MesRecettes

# Prod uniquement (par défaut : staticfiles/ et media/ dans le projet)
# STATIC_ROOT=/var/www/html/staticGestionRecette/
# MEDIA_ROOT=/home/nathansepul/repoGit/GestionDeRecetteAPI/media/

# Import depuis une vidéo TikTok : la recette est mise en forme par l'API Claude
# (clé sur https://console.anthropic.com, facturée à l'usage). Vide = import TikTok désactivé.
ANTHROPIC_API_KEY=
# CLAUDE_MODELE=claude-haiku-5-5
# Alertes si l'API Claude ne répond plus (crédit épuisé, clé invalide...) ; vide = DEBUG_EMAIL
ALERTE_EMAIL=
# Recette dite à l'oral ou écrite à l'écran : la voix est transcrite par Whisper sur le serveur.
# base : 4 fois plus rapide mais des erreurs ; small : bon compromis
# WHISPER_MODELE=small
# Langue des vidéos (fr, en...) ; vide = détection automatique, quelques secondes de plus
# WHISPER_LANGUE=
# VIDEO_DUREE_MAX=600
