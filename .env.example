# Copier en .env et compléter. Générer SECRET_KEY avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=on
SECRET_KEY=

# Base de données MySQL
DB_USER=
DB_PASSWORD=
DB_DATABASE=recette
DB_HOST=localhost
DB_PORT=3306

# Emails (en DEBUG, tous les emails partent vers DEBUG_EMAIL)
DEBUG_EMAIL=
DEFAULT_FROM_EMAIL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=465

APP_NAME=MesRecettes

# Prod uniquement (par défaut : staticfiles/ et media/ dans le projet)
# STATIC_ROOT=/var/www/html/staticGestionRecette/
# MEDIA_ROOT=/home/nathansepul/repoGit/GestionDeRecetteAPI/media/
